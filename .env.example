# Copy to .env (same folder) and fill in. .env is read by agent/pipeline.mjs, agent/granola.mjs and
# mockups/server.mjs; it never goes into the mockup, the eval outputs or the hand-in.
ANTHROPIC_API_KEY=
# optional: claude-sonnet-5-5 (default), claude-haiku-5-5, claude-opus-5-5
ORBITA_MODEL=claude-sonnet-5-5
# optional: low | medium (default) | high
ORBITA_EFFORT=medium
# Granola public API (Business plan): Settings > Connectors > API keys in the desktop app
GRANOLA_API_KEY=
# the folder to sync (fol_...): put one meeting in it, then run node agent/granola.mjs folder-of <note link>
GRANOLA_FOLDER=
