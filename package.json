{
  "name": "orbita-crm-agent",
  "version": "4.0.0",
  "private": true,
  "description": "Orbita CRM Agent (Product Faculty capstone): any sales conversation into the right CRM opportunity, with the agent pipeline, guardrails, eval and an optional Granola connector",
  "scripts": {
    "build:data": "node scripts/build_data.mjs",
    "sync": "node agent/granola.mjs sync",
    "dry-run": "node agent/pipeline.mjs --all --dry-run",
    "mock": "node agent/pipeline.mjs --all --mock",
    "eval": "node eval/run_eval.mjs",
    "test": "node eval/guardrail_tests.mjs && node eval/granola_live_test.mjs",
    "prd": "python scripts/fill_prd.py"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@arizeai/openinference-instrumentation-anthropic": "^1.0.0",
    "@arizeai/openinference-semantic-conventions": "^2.15.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "postgres": "^3.4.9"
  }
}
